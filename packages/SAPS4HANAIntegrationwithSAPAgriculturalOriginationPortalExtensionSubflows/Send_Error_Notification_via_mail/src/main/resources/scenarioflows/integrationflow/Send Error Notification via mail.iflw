                <ifl:property>
                    <key>keep_attachments</key>
                    <value>1</value>
                </ifl:property>
                <ifl:property>
                    <key>body</key>
                    <value>Dear Team,

An error has occurred in the ${header.flowName} integration flow.

Please find the Error Message Details below:

SAP CPI Message ID: ${header.MessageProcessingLogID}
Error Code:  ${header.StatusCode}
Error Text:   ${header.StatusText}
Error Message: ${header.exceptionMessage}
Error Log: {{CI Tenant URL}}/itspaces/shell/monitoring/Messages/%7B%22identifier%22%3A%22${header.MessageProcessingLogID}%22%7D

Detailed Error Message:
${in.body}

Thanks &amp; Regards,
Cloud Platform Integration Team</value>
                </ifl:property>
                <ifl:property>
                    <key>ssl</key>
                    <value>starttls_mandatory</value>
                </ifl:property>
                <ifl:property>
                    <key>timeout</key>
