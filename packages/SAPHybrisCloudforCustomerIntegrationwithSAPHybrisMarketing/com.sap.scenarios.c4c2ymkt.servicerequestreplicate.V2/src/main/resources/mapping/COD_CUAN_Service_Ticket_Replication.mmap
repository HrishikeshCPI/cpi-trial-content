 {
result.addValue( "1");
}
else
 {
result.addValue(ResultList.SUPPRESS);
}</javaText></implementation></functionmodel><functionmodel><signature cacheType="0"><argument jtp="String" nm="in" tp="0"><uiTitle></uiTitle></argument></signature><name>Timestamp2DateTime</name><key>Timestamp2DateTime</key><tab>User-Defined</tab><title>Timestamp2DateTime</title><uiTitle></uiTitle><implementation type="udf"><javaText>return  in.substring(0,4) + "-" + in.substring(4,6) + "-" + in.substring(6,8) + "T" + in.substring(8,10) + ":" + in.substring(10,12) +":" + in.substring(12,14) + "." +in.substring(14,17) ;</javaText></implementation></functionmodel><functionmodel><signature cacheType="0"/><name>getMessageID</name><key>getMessageID</key><tab>User-Defined</tab><title>Get PI Message ID</title><uiTitle></uiTitle><implementation type="udf"><javaText>String MessageID;
java.util.Map param = container.getTransformationParameters();
MessageID = (String) param.get (StreamTransformationConstants.MESSAGE_ID);
return MessageID.toUpperCase();</javaText></implementation></functionmodel><functionmodel><signature cacheType="0"><argument jtp="String" nm="CreationDate" tp="0"><uiTitle></uiTitle></argument><argument jtp="String" nm="CompletionDate" tp="0"><uiTitle></uiTitle></argument></signature><name>CalculateInteractionDuration</name><key>CalculateInteractionDuration</key><tab>User-Defined</tab><title>Interaction Duration in seconds</title><uiTitle></uiTitle><implementation type="udf"><javaText>String time1 = CreationDate;
String time2 = CompletionDate;
long timeElapsed = 0L;
try {

SimpleDateFormat format = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss");
Date start = format.parse(time1);
Date end = format.parse(time2);
timeElapsed = end.getTime() - start.getTime(); 
timeElapsed = timeElapsed/1000;
}

catch (Exception e) {

}


return Long.toString(timeElapsed);</javaText></implementation></functionmodel><usedjars/></functionstorage></entry><entry name="formatDateTime"><libref><ref pos="1" role="UsedFuncLib"><key><key typeID="gsh" version="1.1"><elem>formatDateTime.groovy</elem><elem>src/main/resources/script</elem></key></key></ref></libref></entry></libstorage><transformation><brick gid="0" path="/ImportHeaders/ImportHeader" type="Dst"><viewData x="190" y="25"/><arg><brick gid="0" path="/ns0:TicketReplicationToExternalSystem" type="Src"><viewData x="50" y="25"/></brick></arg><group/></brick><brick gid="0" path="/ImportHeaders/ImportHeader/Id" type="Dst"><viewData x="190" y="25"/><arg><brick fname="getMessageID" fns="usernamespace" type="Func"><viewData x="50" y="25"/></brick></arg><group/></brick><brick gid="0" path="/ImportHeaders/ImportHeader/Timestamp" type="Dst"><viewData x="330" y="25"/><arg><brick fname="substring" fns="dflt" type="Func"><viewData x="190" y="25"/><arg><brick gid="0" path="/ns0:TicketReplicationToExternalSystem/BusinessDocumentMessageHeader/CreationDateTime" type="Src"><viewData x="61" y="66"/></brick></arg><bindings><param name="start"><value>0</value></param><param name="count"><value>23</value></param></bindings></brick></arg><group/></brick><brick gid="0" path="/ImportHeaders/ImportHeader/SourceSystemType" type="Dst"><viewData x="190" y="25"/><arg><brick fname="const" fns="dflt" type="Func"><viewData x="50" y="25"/><bindings><param name="value"><value>C4C</value></param></bindings></brick></arg><group/></brick><brick gid="0" path="/ImportHeaders/ImportHeader/SourceSystemId" type="Dst"><viewData x="330" y="25"/><arg><brick fname="valuemap" fns="dflt" type="Func"><viewData x="190" y="25"/><arg><brick gid="0" path="/ns0:TicketReplicationToExternalSystem/BusinessDocumentMessageHeader/SenderParty/InternalID" type="Src"><viewData x="67" y="61"/></brick></arg><bindings><param name="srcns"><value>newInterfaceFunction</value></param><param name="srctype"><value/></param>