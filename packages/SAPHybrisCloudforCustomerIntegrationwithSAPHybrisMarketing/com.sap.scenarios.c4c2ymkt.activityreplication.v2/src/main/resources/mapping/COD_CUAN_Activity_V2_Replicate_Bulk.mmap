				String val = "";
				if(  Values.length == 1 &amp;&amp; Strict == "" )
         {
               val = Values[0] ;
         }
         else
         {
          	for ( i = 0; i &lt; Condition.length; i++)
          	{
            	if ( Condition[i].equals( "true") )
            	{
								 val = Values[i] ;
            	}
           	}
					}
result.addValue( val );</javaText></implementation></functionmodel><functionmodel><signature cacheType="0"><argument jtp="String" nm="in" tp="0"><uiTitle></uiTitle></argument></signature><name>Timestamp2DateTime</name><key>Timestamp2DateTime</key><tab>User-Defined</tab><title>Timestamp2DateTime</title><uiTitle></uiTitle><implementation type="udf"><javaText>return  in.substring(0,4) + "-" + in.substring(4,6) + "-" + in.substring(6,8) + "T" + in.substring(8,10) + ":" + in.substring(10,12) +":" + in.substring(12,14)  + "." +in.substring(14,17)  ;</javaText></implementation></functionmodel><functionmodel><signature cacheType="0"/><name>getMessageID</name><key>getMessageID</key><tab>User-Defined</tab><title>Get PI message ID</title><uiTitle></uiTitle><implementation type="udf"><javaText>String MessageID;
java.util.Map param = container.getTransformationParameters();
MessageID = (String) param.get (StreamTransformationConstants.MESSAGE_ID);
return MessageID.toUpperCase();</javaText></implementation></functionmodel><functionmodel><signature cacheType="0"><argument jtp="String" nm="var1" tp="0"><uiTitle></uiTitle></argument></signature><name>uuid</name><key>uuid</key><tab>User-Defined</tab><title>FormatUUID</title><uiTitle></uiTitle><implementation type="udf"><javaText>
  if ( var1.length() == 32 ) {
   var1.toLowerCase();
	String uuid = var1.replaceAll(  "(\\w{8})(\\w{4})(\\w{4})(\\w{4})(\\w{12})", "$1-$2-$3-$4-$5");
  	return uuid;
 }
else
	if ( var1.length() == 0 )
 		 return "00000000-0000-0000-0000-000000000000";
	else
		return var1;</javaText></implementation></functionmodel><functionmodel><signature cacheType="0"><argument jtp="String" nm="in" tp="0"><uiTitle></uiTitle></argument></signature><name>formatDateTime</name><key>formatDateTime</key><tab>User-Defined</tab><title>formatDateTime</title><uiTitle></uiTitle><implementation type="udf"><javaText>if ( in.length() &gt; 23 ) {
 return  in.substring(0,23) ; 
}
else {
 return in.substring(0, in.length() - 1) ;
}</javaText></implementation></functionmodel><usedjars/></functionstorage></entry></libstorage><transformation><brick gid="0" path="/ImportHeaders/ImportHeader" type="Dst"><viewData x="190" y="25"/><arg><brick gid="0" path="/ns0:ActivityReplicationRequest/MessageHeader" type="Src"><viewData x="50" y="25"/></brick></arg><group/></brick><brick gid="0" path="/ImportHeaders/ImportHeader/Id" type="Dst"><viewData x="190" y="25"/><arg><brick fname="getMessageID" fns="usernamespace" type="Func"><viewData x="50" y="25"/></brick></arg><group/></brick><brick gid="0" path="/ImportHeaders/ImportHeader/Timestamp" type="Dst"><viewData x="330" y="25"/><arg><brick fname="formatDateTime" fns="usernamespace" type="Func"><viewData x="190" y="25"/><arg><brick gid="0" path="/ns0:ActivityReplicationRequest/MessageHeader/CreationDateTime" type="Src"><viewData x="50" y="25"/></brick></arg></brick></arg><group/></brick><brick gid="0" path="/ImportHeaders/ImportHeader/SourceSystemType" type="Dst"><viewData x="190" y="25"/><arg><brick fname="const" fns="dflt" type="Func"><viewData x="50" y="25"/><bindings><param name="value"><value>C4C</value></param></bindings></brick></arg><group/></brick><brick gid="0" path="/ImportHeaders/ImportHeader/SourceSystemId" type="Dst"><viewData x="330" y="25"/><arg><brick fname="valuemap" fns="dflt" type="Func"><viewData x="190" y="25"/><arg><brick gid="0" path="/ns0:ActivityReplicationRequest/MessageHeader/SenderParty/InternalID" type="Src"><viewData x="50" y="25"/></brick></arg><bindings><param name="srcns"><value>newInterfaceFunction</value></param><param name="srctype"><value/></param><param name="dstns"><value/></param><param name="dsttype"><value/></param><param name="context"><value>http://sap.com/xi/XI</value></param><param name="agency1"><value>COD</value></param><param name="schema1"><value>BusinessSystemID</value></param><param name="agency2"><value>CUAN</value></param><param name="schema2"><value>SystemID</value></param><param name="vmstrategy"><value